#!/usr/bin/env bash
# Root-owned trust boundary for the public repository's self-hosted runner.
# It never executes the runner workspace: it deploys only the exact current
# head of origin/production into a dedicated, root-owned release checkout.
set -Eeuo pipefail

[[ $# == 1 && "$1" =~ ^[0-9a-f]{40}$ ]] || { echo 'Expected one full Git SHA.' >&2; exit 2; }
requested_sha="$1"
remote="https://github.com/Rezz0722/cafe.git"
release_dir="/opt/kucafe-release"
lock_file="/run/lock/kucafe-release-fetch.lock"

exec 9>"$lock_file"
flock -n 9 || { echo 'Another release checkout is running.' >&2; exit 75; }
remote_sha="$(git ls-remote "$remote" refs/heads/production | awk '{print $1}')"
[[ -n "$remote_sha" && "$requested_sha" == "$remote_sha" ]] || {
  echo 'Refusing deploy: SHA is not the current origin/production head.' >&2
  exit 1
}

if [[ ! -d "$release_dir/.git" ]]; then
  [[ ! -e "$release_dir" ]] || { echo "$release_dir exists but is not a Git checkout." >&2; exit 1; }
  git clone --filter=blob:none --no-checkout "$remote" "$release_dir"
fi
git -C "$release_dir" remote set-url origin "$remote"
git -C "$release_dir" fetch --prune origin production
git -C "$release_dir" checkout --detach "$requested_sha"
git -C "$release_dir" clean -ffd

env \
  GITHUB_SHA="$requested_sha" \
  KUCAFE_ENV_FILE=/opt/kucafe/.env.local \
  KUCAFE_MEDIA_DIR=/var/www/kucafe/public/media \
  KUCAFE_BACKUP_DIR=/var/backups/kucafe \
  KUCAFE_DEPLOY_STATE_DIR=/var/lib/kucafe \
  bash "$release_dir/scripts/docker-deploy.sh"

# These are idempotent. The first successful GitHub deployment performs the
# guarded Apache cutover; later deployments simply keep the cron definition in
# sync. PM2 remains available on :3000 as a first-week emergency fallback.
bash "$release_dir/scripts/install-media-cron.sh"
if ! grep -q '127\.0\.0\.1:3100' /etc/httpd/conf/extra/kucafe-tls.conf 2>/dev/null; then
  bash "$release_dir/deploy/server/cutover-to-docker.sh"
fi
