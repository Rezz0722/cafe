# ═══════════════════════════════════════════════════════════════════════
#  deploy.env — تنها فایلی که قبل از اجرای ./deploy.sh باید پر کنی
#
#  این را کپی کن به `deploy.env` (بدون .example) و مقدارها را بگذار:
#
#      cp deploy.env.example deploy.env
#      nano deploy.env
#      ./deploy.sh
#
#  ⚠️ `deploy.env` راز دارد (رمز دیتابیس، کلید پیامک) و در .gitignore است.
#     هرگز commitش نکن.
# ═══════════════════════════════════════════════════════════════════════

# ── دیتابیس ─────────────────────────────────────────────────────────────
# نام دیتابیس و کاربرِ اپ. اگر CREATE_DB=1 باشد، deploy.sh خودش می‌سازدشان.
DB_NAME=kucafe
DB_USER=kucafe
# رمزِ کاربرِ اپ. حروف و عدد بگذار (بدون @ : / تا در DATABASE_URL مشکل نسازد).
DB_PASS=

# اگر دیتابیس و کاربر هنوز ساخته نشده‌اند، این را 1 کن تا deploy.sh با
# دسترسی root سوکت (mysql -u root) بسازدشان. اگر از قبل ساخته‌ای، 0 بگذار.
CREATE_DB=1

# ── پیامک (SMS.ir) ──────────────────────────────────────────────────────
# تا وقتی خالی باشند، AUTH_DEV_MODE=true می‌ماند و کد ورود در لاگ چاپ می‌شود
# (پیامک واقعی فرستاده نمی‌شود). وقتی کلید را گذاشتی، AUTH_DEV_MODE خودکار
# false می‌شود و هر ورود یک پیامک واقعیِ پولی می‌فرستد.
SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
# شماره‌های ادمین، با کاما جدا کن. اولین ورودِ این شماره‌ها ادمین می‌شود.
ADMIN_PHONES=

# ── دامنه (فقط برای پیام راهنمای پایان کار) ─────────────────────────────
DOMAIN=kucafe.ir

# ── رفتار ───────────────────────────────────────────────────────────────
# 1 = تصاویر (۱ گیگ) در پس‌زمینه از منبع بازسازی شوند. 0 = رد شو (بعداً
#     دستی: npm run media:download). اگر بکاپِ حاوی مدیا کنارش باشد، از آن
#     بازیابی می‌شود و این نادیده گرفته می‌شود.
DOWNLOAD_MEDIA=1
