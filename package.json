{
  "name": "kucafe",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "کافه‌گرد — راهنمای کافه‌ها و رستوران‌های مشهد",
  "scripts": {
    "postinstall": "node scripts/sync-map-worker.mjs && node scripts/sync-favicon.mjs",
    "predev": "node scripts/sync-map-worker.mjs",
    "dev": "node node_modules/next/dist/bin/next dev",
    "prebuild": "npm run map:worker && npm run map:publish && npm run brand:favicon",
    "build": "bash scripts/safe-build.sh",
    "build:next": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "eslint src scripts/admin-upgrade-*.ts",
    "admin:upgrade:smoke": "node --import tsx --conditions=react-server scripts/admin-upgrade-core-smoke.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node --import tsx --conditions=react-server --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/ensure-drizzle-baseline.mjs && drizzle-kit migrate && npm run db:project-migrations && npm run db:extras && npm run db:mariadb-fix",
    "db:baseline:check": "node scripts/ensure-drizzle-baseline.mjs --check",
    "db:push": "drizzle-kit push && npm run db:extras && npm run db:mariadb-fix",
    "db:extras": "node scripts/run-sql.mjs drizzle/mysql-extras.sql",
    "db:project-migrations": "node scripts/apply-project-migrations.mjs",
    "db:verify": "node scripts/db-verify.mjs",
    "db:smoke": "node --import tsx --conditions=react-server scripts/db-smoke.ts",
    "db:studio": "drizzle-kit studio",
    "import:cafes": "node --import tsx --conditions=react-server scripts/import-cafes.ts",
    "build:facets": "node --import tsx --conditions=react-server scripts/build-facets.ts",
    "attributes:seed": "node --import tsx --conditions=react-server scripts/seed-attributes.ts",
    "media:seed": "node --import tsx --conditions=react-server scripts/media-seed.ts",
    "media:download": "node --import tsx --conditions=react-server scripts/media-download.ts",
    "media-upload:smoke": "node --import tsx --conditions=react-server scripts/media-upload-smoke.ts",
    "user:create": "node --import tsx --conditions=react-server scripts/create-user.ts",
    "map:worker": "node scripts/sync-map-worker.mjs",
    "brand:favicon": "node scripts/sync-favicon.mjs",
    "map:extract": "node --max-old-space-size=4096 scripts/map-extract.mjs",
    "map:publish": "node scripts/map-publish.mjs",
    "map:smoke": "node --import tsx --conditions=react-server scripts/map-smoke.ts",
    "query:smoke": "node --import tsx --conditions=react-server scripts/query-smoke.ts",
    "items:smoke": "node --import tsx --conditions=react-server scripts/items-smoke.ts",
    "auth:smoke": "node --import tsx --conditions=react-server scripts/auth-smoke.ts",
    "branch:smoke": "node --import tsx --conditions=react-server scripts/branch-smoke.ts",
    "qr:smoke": "node scripts/qr-smoke.mjs",
    "pages:smoke": "node scripts/pages-smoke.mjs",
    "pages:auth-smoke": "node --import tsx --conditions=react-server scripts/pages-auth-smoke.ts",
    "seo:smoke": "node scripts/seo-smoke.mjs",
    "seo:crawl": "node scripts/seo-crawl.mjs",
    "manage:smoke": "node --import tsx --conditions=react-server scripts/manage-smoke.ts",
    "venue-media:smoke": "node --import tsx --conditions=react-server scripts/venue-media-smoke.ts",
    "venue-ui:smoke": "node --import tsx --conditions=react-server scripts/venue-ui-smoke.ts",
    "search-ui:smoke": "node --import tsx --conditions=react-server scripts/search-ui-smoke.ts",
    "cafe-ui:smoke": "node --import tsx --conditions=react-server scripts/cafe-ui-smoke.ts",
    "home-ui:smoke": "node --import tsx --conditions=react-server scripts/home-ui-smoke.ts",
    "phase0:baseline": "node scripts/phase0-baseline.mjs",
    "phase0:ui-smoke": "node --import tsx --conditions=react-server scripts/phase0-ui-smoke.ts",
    "backup:restore-drill": "node scripts/restore-drill.mjs",
    "phase6:smoke": "node --import tsx --conditions=react-server scripts/phase6-mobile-matrix.ts",
    "registration:no-otp:smoke": "node --import tsx --conditions=react-server scripts/registration-no-otp-smoke.ts",
    "blogger-club:smoke": "node --import tsx --conditions=react-server scripts/blogger-club-smoke.ts",
    "menu-variant:smoke": "node --import tsx --conditions=react-server scripts/menu-variant-smoke.ts",
    "admin:smoke": "node --import tsx --conditions=react-server scripts/admin-smoke.ts",
    "settings:smoke": "node --import tsx --conditions=react-server scripts/settings-smoke.ts",
    "settings:effect": "node --import tsx --conditions=react-server scripts/settings-effect-smoke.ts",
    "prices:recompute": "node --import tsx --conditions=react-server scripts/recompute-price-stats.ts",
    "backup:full": "bash scripts/backup-full.sh",
    "restore:full": "bash scripts/restore-full.sh",
    "taxonomy:coverage": "node --import tsx --conditions=react-server scripts/taxonomy-coverage.ts",
    "deploy": "npm run db:migrate && npm run build && bash scripts/reload-safe.sh",
    "reload:safe": "bash scripts/reload-safe.sh",
    "deploy:verify": "npm run db:verify && npm run map:smoke && npm run query:smoke",
    "docker:config": "docker compose --env-file .env.compose config",
    "docker:local": "docker compose -f compose.local.yaml up --build",
    "secrets:check": "bash scripts/check-no-secrets.sh",
    "db:mariadb-fix": "node scripts/run-sql.mjs drizzle/mariadb-timestamps.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "leaflet": "1.9.4",
    "lucide-react": "^1.29.0",
    "maplibre-gl": "^6.9.0",
    "mysql2": "^3.23.2",
    "next": "^15.5.25",
    "osm-pbf-parser": "^2.3.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "15.5.25",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^6.1.1",
    "jsqr": "1.4.0",
    "playwright": "1.55.1",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "nanoid": "3.3.19",
    "postcss": "8.5.28"
  }
}
