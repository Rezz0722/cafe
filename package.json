{
  "name": "cafegard",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "کافه‌گرد — راهنمای کافه‌ها و رستوران‌های مشهد",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --conditions=react-server --test \"src/**/*.test.ts\"",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push && npm run db:extras",
    "import:cafes": "tsx --conditions=react-server scripts/import-cafes.ts",
    "user:create": "tsx --conditions=react-server scripts/create-user.ts",
    "db:extras": "node scripts/run-sql.mjs drizzle/mysql-extras.sql",
    "db:smoke": "tsx --conditions=react-server scripts/db-smoke.ts",
    "db:studio": "drizzle-kit studio",
    "media:seed": "tsx --conditions=react-server scripts/media-seed.ts",
    "media:download": "tsx --conditions=react-server scripts/media-download.ts",
    "query:smoke": "tsx --conditions=react-server scripts/query-smoke.ts",
    "build:facets": "tsx --conditions=react-server scripts/build-facets.ts",
    "taxonomy:coverage": "tsx --conditions=react-server scripts/taxonomy-coverage.ts",
    "map:extract": "node --max-old-space-size=4096 scripts/map-extract.mjs",
    "map:smoke": "tsx --conditions=react-server scripts/map-smoke.ts",
    "auth:smoke": "tsx --conditions=react-server scripts/auth-smoke.ts",
    "pages:smoke": "node scripts/pages-smoke.mjs",
    "manage:smoke": "tsx --conditions=react-server scripts/manage-smoke.ts",
    "admin:smoke": "tsx --conditions=react-server scripts/admin-smoke.ts",
    "settings:smoke": "tsx --conditions=react-server scripts/settings-smoke.ts",
    "settings:effect": "tsx --conditions=react-server scripts/settings-effect-smoke.ts",
    "db:verify": "node scripts/db-verify.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "geojson-vt": "^4.0.3",
    "maplibre-gl": "^6.1.0",
    "mysql2": "^3.23.2",
    "next": "^15.5.22",
    "osm-pbf-parser": "^2.3.0",
    "pbf": "^5.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.6",
    "tsx": "^4.23.1",
    "typescript": "^5.6.3"
  }
}
