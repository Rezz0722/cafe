# ═══ کافه‌گرد — نمونه‌ی تنظیمات ═══
# این فایل در git هست. مقادیر واقعی در .env.local که در git نیست.
#    cp .env.example .env.local

# آدرس کانونی سایت — در sitemap و JSON-LD استفاده می‌شود
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# اتصال دیتابیس. در Production مقدار واقعی فقط در env سرور نگهداری می‌شود.
DATABASE_URL=mysql://kucafe:kucafe-local-only@127.0.0.1:3306/kucafe

# ── امضای نشست ──
# رشته‌ی تصادفی حداقل ۳۲ کاراکتر. با این دستور بسازید:
#    node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# عوض‌کردنش همه‌ی نشست‌های فعال را باطل می‌کند.
SESSION_SECRET=

# ── SMS.ir ──
# کلید از پنل: app.sms.ir → برنامه‌نویسان → لیست کلیدهای API
SMSIR_API_KEY=

# روش ارسال — یکی از این دو را پر کنید:
#  ۱) توصیه‌شده: قالب OTP بسازید (پنل → ارسال سریع → لیست قالب‌ها)
#     و شناسه‌اش را اینجا بگذارید. خط OTP فیلتر نمی‌شود و تحویل بهتری دارد.
SMSIR_TEMPLATE_ID=
#     نام پارامتر کد در قالب (پیش‌فرض CODE)
SMSIR_TEMPLATE_PARAM=CODE
#  ۲) موقت: ارسال با خط عادی. بدون قالب کار می‌کند ولی برای OTP
#     ایده‌آل نیست (احتمال تأخیر/فیلتر).
SMSIR_LINE_NUMBER=

# ── حالت توسعه ──
# true یعنی پیامکی ارسال نمی‌شود و کد در ترمینال چاپ می‌شود.
# برای کار محلی روشن بگذارید تا اعتبار پیامک نسوزد.
AUTH_DEV_MODE=true

# ── ادمین‌ها ──
# شماره‌هایی که با ورود، نقش admin می‌گیرند. با کاما جدا کنید.
# مثال: 09151234567,09351234567
ADMIN_PHONES=
